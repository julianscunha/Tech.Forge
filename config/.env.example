# TechForge Core Configuration
# Copy this file to .env and adjust values

# Platform
PLATFORM_NAME=TechForge
PLATFORM_VERSION=1.0.0

# Backend server
HOST=127.0.0.1
PORT=8000
RELOAD=true

# Database — SQLite for local mode, switch to PostgreSQL for server mode
# Local:  sqlite+aiosqlite:///./config/techforge.db
# Server: postgresql+asyncpg://user:password@host:5432/techforge
DATABASE_URL=sqlite+aiosqlite:///./config/techforge.db

# CORS origins (comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
