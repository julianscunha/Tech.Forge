# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node
node_modules/
.cache/
*.local

# Build output
dist/
graphify-out/

# Env
.env
!.env.example

# Database
*.db
*.sqlite3

# Logs
logs/*.log
logs/*.txt
logs/pids/

# Runtime state (gerado, não versionar)
modules/installed/*/data/settings.json

# Artefato acidental de rodar scripts/pytest com cwd=core/backend
# (settings.MODULES_INSTALLED_PATH resolve relativo ao CWD)
/core/backend/modules/
/cli/modules/

# IDE
.vscode/
.idea/
*.swp

# Agent tooling (config/skills locais — não fazem parte do produto)
.claude/
.agents/

# Test/lint caches
.pytest_cache/
.ruff_cache/
